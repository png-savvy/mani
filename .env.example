# Copy to .env and edit. Never commit .env.

# Where the server listens. Keep 127.0.0.1 unless a reverse proxy/container needs otherwise.
HOST=127.0.0.1
PORT=3000

# Where your budget database lives (back this folder up!).
DATA_DIR=./data

# Optional: key used to encrypt bank access tokens. If unset, one is generated in DATA_DIR/secret.key.
# ENCRYPTION_KEY=some-long-random-string

# Your time zone, so "today" and scheduled transactions match your calendar.
TZ=America/New_York

# How often to pull new bank transactions automatically (hours, 0 = off). Can also be changed in Settings.
SYNC_INTERVAL_HOURS=6

# ---- Plaid (optional; SimpleFIN needs no configuration) ----
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox          # sandbox | production
# PLAID_COUNTRY_CODES=US     # e.g. US,CA
# PLAID_REDIRECT_URI=https://budget.example.com/oauth-return   # optional: only for phone in-app browsers/webviews
